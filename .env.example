# Environment (dev, test, prod)
NODE_ENV=dev

# Server
PORT=3333

# Local image uploads directory (served under /uploads)
UPLOAD_DIR=uploads

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key

# Use 'localhost' for local host development or 'postgres' inside Docker Compose
DATABASE_URL="postgresql://bookify_user:bookify_pass@localhost:5432/bookify_db?schema=public"

# Use 'localhost' for local host development or 'redis' inside Docker Compose
REDIS_URL=redis://localhost:6379

# Payment provider ('mock' for local development, 'stripe' for real Checkout Sessions)
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=usd
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Required when PAYMENT_PROVIDER=stripe; obtain values from Stripe Dashboard / CLI
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me