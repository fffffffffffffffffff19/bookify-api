{
  "name": "bookify-api",
  "version": "1.0.0",
  "main": "./dist/server.cjs",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "26.13.0",
    "yarn": "1.22.22"
  },
  "repository": "https://github.com/fffffffffffffffffff19/bookify-api.git",
  "author": "@fffffffffffffffffff19 <davischiavon21@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.4",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.90.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-environment-prisma": "file:./prisma/vitest-environment-prisma"
  },
  "scripts": {
    "start": "node dist/server.cjs",
    "start:docker": "docker compose up --build",
    "start:dev": "tsx watch src/server.ts",
    "start:worker": "node dist/worker.cjs",
    "start:worker:dev": "tsx watch src/worker.ts",
    "build": "tsup src/server.ts src/worker.ts --out-dir dist --no-splitting --format cjs",
    "lint": "oxlint src",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e --maxWorkers=1",
    "test:e2e:watch": "vitest --project e2e --maxWorkers=1",
    "db:generate": "yarn prisma generate",
    "db:migrate": "yarn prisma migrate deploy",
    "db:seed": "yarn prisma db seed",
    "db:studio": "yarn prisma studio"
  }
}
